#!/bin/sh
# 地震数据代理 CGI — 30 分钟缓存 + 单飞锁
#   数据源 cn.apihz.cn（转发中国地震台网），免费版只限制每分钟调用次数
#   ?a=list      国内速报 dizhen.php：最近 30 条，原样透传 JSON
#   ?a=global    全球震情速报 dizhensu.php：最近 10 条（含海外），原样透传 JSON
#   ?a=cache     两个缓存的状态
#   ?a=flush     清两个缓存
#
# 凭据放在 /data/iptv/etc/quake.conf（chmod 600），两个接口共用同一份：
#   Q_ID=你的数字ID
#   Q_KEY=你的KEY

CONF=${QUAKE_CONF:-/data/iptv/etc/quake.conf}
CN_CACHE=${QUAKE_CACHE:-/tmp/quake_cache.json}
GL_CACHE=${QUAKE_CACHE_GLOBAL:-/tmp/quake_global_cache.json}
CN_LOCK=/tmp/quake.lock
GL_LOCK=/tmp/quake_global.lock
TTL=1800
Q_ID=""
Q_KEY=""
[ -f "$CONF" ] && . "$CONF"

hdr() {
  printf 'Content-Type: application/json; charset=utf-8\r\n'
  printf 'Cache-Control: no-store\r\n\r\n'
}
getp() {
  printf '%s' "$QUERY_STRING" | tr '&' '\n' | grep "^$1=" | head -1 | cut -d= -f2- \
    | sed 's/+/ /g'
}

A=$(getp a)
case "$A" in
  global)
    # 震情速报：国内 + 海外混合，字段带 weidu2 / jingdu2 方向标注
    URL="https://cn.apihz.cn/api/tianqi/dizhensu.php"
    CACHE="$GL_CACHE"
    LOCK="$GL_LOCK"
    ;;
  *)
    URL="https://cn.apihz.cn/api/tianqi/dizhen.php"
    CACHE="$CN_CACHE"
    LOCK="$CN_LOCK"
    ;;
esac
CACHE_TS=$CACHE.ts

fetch() {
  curl -s -m 15 -H 'User-Agent: ra81-iptv' \
    "$URL?id=$Q_ID&key=$Q_KEY" 2>/dev/null
}

fresh() {
  [ -s "$CACHE" ] && [ -f "$CACHE_TS" ] || return 1
  now=$(date +%s)
  ts=$(cat "$CACHE_TS" 2>/dev/null || echo 0)
  [ $((now - ts)) -lt "$TTL" ]
}

wait_cache() {
  n=0
  while [ $n -lt 3 ]; do
    [ -s "$CACHE" ] && return 0
    sleep 1
    n=$((n + 1))
  done
  [ -s "$CACHE" ]
}

stat() {
  c=$1
  if [ -s "$c" ]; then
    printf '{"bytes":%s,"age":%s}' \
      "$(wc -c < "$c" | tr -d ' ')" \
      "$(( $(date +%s) - $(cat "$c.ts" 2>/dev/null || echo 0) ))"
  else
    printf '{"bytes":0}'
  fi
}

case "$A" in
  cache)
    hdr
    printf '{"ok":1,"ttl":%s,"conf":%s,"cn":%s,"global":%s}\n' \
      "$TTL" "$([ -n "$Q_KEY" ] && echo true || echo false)" \
      "$(stat "$CN_CACHE")" "$(stat "$GL_CACHE")"
    ;;
  flush)
    rm -f "$CN_CACHE" "$CN_CACHE.ts" "$GL_CACHE" "$GL_CACHE.ts"
    rmdir "$CN_LOCK" "$GL_LOCK" 2>/dev/null
    hdr
    printf '{"ok":1,"msg":"国内与全球缓存已清"}\n'
    ;;
  *)
    if [ -z "$Q_ID" ] || [ -z "$Q_KEY" ]; then
      hdr
      printf '{"code":400,"msg":"未配置凭据，见 /data/iptv/etc/quake.conf"}\n'
      exit 0
    fi
    if fresh; then
      hdr
      cat "$CACHE"
      exit 0
    fi
    if mkdir "$LOCK" 2>/dev/null; then
      trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
      body=$(fetch)
      # 上游是格式化过的 JSON（"code": 200 带空格），先把空白压掉再判断，
      # 否则永远匹配不上，缓存也就永远写不进去
      flat=$(printf '%s' "$body" | tr -d ' \t\r\n')
      case "$flat" in
        *'"code":200'*)
          printf '%s' "$body" > "$CACHE.tmp" && mv -f "$CACHE.tmp" "$CACHE"
          date +%s > "$CACHE_TS"
          hdr
          printf '%s' "$body"
          exit 0
          ;;
      esac
      # 频次超限 / 网络失败：有旧数据就继续给旧的
      hdr
      if [ -s "$CACHE" ]; then
        cat "$CACHE"
      elif [ -n "$body" ]; then
        printf '%s' "$body"
      else
        printf '{"code":-1,"msg":"上游取数失败"}\n'
      fi
    else
      if wait_cache; then
        hdr
        cat "$CACHE"
      else
        hdr
        printf '{"code":-2,"msg":"上游正在取数，请稍后刷新"}\n'
      fi
    fi
    ;;
esac
